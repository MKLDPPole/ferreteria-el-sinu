# Copia este archivo como .env y ajusta los valores según tu entorno.

# PostgreSQL
DATABASE_URL=postgresql://postgres:sinu2026@localhost:5432/ferreteria_sinu

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SEGUNDOS=300

# Seguridad (genera una clave real con: openssl rand -hex 32)
SECRET_KEY=cambia-esta-clave-en-produccion-por-una-generada-con-openssl
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS: dominios del frontend permitidos (separados como lista JSON)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
